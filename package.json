  "scripts": {
    "test:all": "npx playwright test",
    "test:range": "npx playwright test tests/rangeslider.spec.ts",
    "test:qr": "npx playwright test tests/qr.spec.ts",
    "test:api": "npx playwright test tests/api.spec.ts",
    "test:redirect": "npx playwright test tests/redirect.spec.ts",
    "test:menu": "npx playwright test tests/menu.spec.ts",
    "test:test": "npx playwright test tests/test.spec.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defused15/QA-Playground-Tests.git"
  },
